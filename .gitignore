# Python bytecode, environments and build artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, lint, coverage and notebook caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# Credentials and machine-specific configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key
.aws/
.tools/

# Local SQLite wallets (including WAL/SHM files)
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Generated model caches; the app recreates these
models/*
!models/.gitkeep
*.keras
*.h5
*.hdf5

# Runtime output and machine-specific process state
*.log
data/local_services.json
data/*launcher*.json
data/*_live_result*.json
data/*_live_results.json
data/tmp*/

# Editors and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
